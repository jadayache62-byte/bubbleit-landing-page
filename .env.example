CUSTOMER_API_BASE=https://bubbleit-backend.on-forge.com/api/v1/customer
# Local verification only. Set false to prevent Sentry build uploads and telemetry.
# Omit in the normal release pipeline to preserve its existing behavior.
# SENTRY_BUILD_UPLOADS=false
# Isolated browser tests set this false for client, server and edge reporting.
# NEXT_PUBLIC_SENTRY_ENABLED=false
# External MAD-58 release input. Leave unset until the approved web-push
# provider and backend adapter use the corresponding private key.
# NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Public, restricted browser configuration. Keep these unset until the live-fleet
# feature flag, exact Reverb origin, and Google Maps referrer restrictions are approved.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
