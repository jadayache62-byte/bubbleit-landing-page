{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bubbleit:api:public-contract:v1",
  "title": "BubbleIt public API contract v1",
  "description": "Backend-owned response, pagination, enum, and customer commerce resource contract shared by BubbleIt clients.",
  "x-contract-version": "public-contract-v1",
  "x-http-error-statuses": [400, 401, 403, 404, 409, 422, 429, 500, 503],
  "type": "object",
  "required": ["success", "message", "data", "errors"],
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {},
    "errors": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      ]
    },
    "code": { "$ref": "#/$defs/ErrorCode" }
  },
  "additionalProperties": false,
  "$defs": {
    "BookingStatus": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "assigned",
        "driver_accepted",
        "phone_confirmed",
        "in_progress",
        "completed",
        "no_show",
        "refund_requested",
        "cancelled_by_admin",
        "cancelled_by_customer"
      ]
    },
    "StoreOrderStatus": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "confirmed",
        "preparing",
        "out_for_delivery",
        "delivered",
        "cancelled",
        "refunded"
      ]
    },
    "StorePaymentStatus": {
      "type": "string",
      "enum": ["unpaid", "pending", "paid", "failed", "refunded"]
    },
    "PaymentStateStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "not_required",
        "ready",
        "retryable",
        "failed",
        "cancelled",
        "timed_out",
        "pending",
        "cash_due",
        "paid",
        "partially_refunded",
        "refunded",
        "reconciliation_required"
      ]
    },
    "VehicleType": {
      "type": "string",
      "enum": [
        "sedan",
        "suv",
        "truck",
        "van",
        "caravan",
        "jet_ski",
        "jet_boat",
        "other"
      ]
    },
    "CustomerMembershipStatus": {
      "type": "string",
      "enum": ["pending_payment", "active", "exhausted", "expired", "cancelled"]
    },
    "PaymentMethod": {
      "type": "string",
      "enum": ["pay_on_site", "online", "cash", "membership", "membership_with_products", "membership_with_balance", "loyalty"]
    },
    "CustomerNotificationType": {
      "type": "string",
      "enum": [
        "booking_created",
        "payment_confirmed",
        "booking_cancelled",
        "booking_status_changed",
        "booking_reminder_24h",
        "booking_reminder_2h",
        "refund_status_changed",
        "membership_status_changed",
        "store_order_status_changed",
        "review_requested",
        "loyalty_reward_earned",
        "tracking_available"
      ]
    },
    "CustomerDispatchState": {
      "type": "string",
      "enum": ["looking_for_bus", "assigned", "en_route", "arrived", "service_started", "closed"]
    },
    "CustomerTrackingReason": {
      "type": "string",
      "enum": [
        "feature_disabled",
        "not_assigned",
        "before_window",
        "prior_service_active",
        "location_stale",
        "location_disconnected",
        "route_unavailable",
        "service_started",
        "trip_interrupted",
        "booking_terminal"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DURATION_VERSION_STALE",
        "IDEMPOTENCY_KEY_REUSED",
        "PAYMENT_ALREADY_CAPTURED",
        "PAYMENT_IDEMPOTENCY_KEY_INVALID",
        "PAYMENT_INITIALIZATION_RETRYABLE",
        "PAYMENT_PURCHASE_CHANGED",
        "PAYMENT_RECONCILIATION_REQUIRED",
        "SERVICE_AREA_OUTSIDE_QATAR",
        "SERVICE_AREA_STALE",
        "STORE_PRICING_CHANGED",
        "STORE_PRICING_CONFIRMATION_REQUIRED",
        "VALIDATION_FAILED",
        "trip_already_en_route"
      ]
    },
    "PaginationMeta": {
      "type": "object",
      "required": ["current_page", "last_page", "per_page", "total"],
      "properties": {
        "current_page": { "type": "integer", "minimum": 1 },
        "last_page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "PaginatedData": {
      "type": "object",
      "required": ["data", "meta"],
      "properties": {
        "data": { "type": "array" },
        "meta": { "$ref": "#/$defs/PaginationMeta" }
      },
      "additionalProperties": true
    },
    "PaymentState": {
      "type": "object",
      "required": [
        "status",
        "captured",
        "reconciliation_reason",
        "checkout_url",
        "channel"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/PaymentStateStatus" },
        "captured": { "type": "boolean" },
        "reconciliation_reason": { "type": ["string", "null"] },
        "checkout_url": { "type": ["string", "null"] },
        "channel": {
          "type": ["string", "null"],
          "enum": ["cash", "skipcash_hosted", "skipcash_qpay", "paylater", "membership", null]
        }
      },
      "additionalProperties": false
    },
    "RefundState": {
      "type": "object",
      "required": ["id", "status", "status_label"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "status": {
          "enum": [
            "submitted",
            "under_review",
            "approved",
            "processing",
            "retryable",
            "quarantined",
            "rejected",
            "processed"
          ]
        },
        "status_label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CustomerNotification": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "body",
        "locale",
        "is_read",
        "deep_link",
        "created_at"
      ],
      "properties": {
        "id": { "type": "integer" },
        "type": { "$ref": "#/$defs/CustomerNotificationType" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "locale": { "enum": ["en", "ar"] },
        "is_read": { "type": "boolean" },
        "deep_link": {
          "type": "string",
          "pattern": "^/account\\?notification=[0-9]+$"
        },
        "created_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "CustomerNotificationPreference": {
      "type": "object",
      "required": ["locale", "push_enabled", "transactional_fallback"],
      "properties": {
        "locale": { "enum": ["en", "ar"] },
        "push_enabled": { "type": "boolean" },
        "transactional_fallback": { "const": true }
      },
      "additionalProperties": false
    },
    "CustomerNotificationDevice": {
      "type": "object",
      "required": ["id", "platform", "name", "locale", "last_seen_at"],
      "properties": {
        "id": { "type": "integer" },
        "platform": { "enum": ["web", "ios", "android"] },
        "name": { "type": ["string", "null"] },
        "locale": { "enum": ["en", "ar"] },
        "last_seen_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "NotificationDeepLinkResolution": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/account\\?" }
      },
      "additionalProperties": false
    },
    "StoreProduct": {
      "type": "object",
      "required": [
        "id",
        "sku",
        "name",
        "name_ar",
        "description",
        "description_ar",
        "price",
        "imageSrc",
        "stock_quantity",
        "sold_quantity",
        "reserved_quantity",
        "available_quantity",
        "category",
        "is_available"
      ],
      "properties": {
        "id": { "type": "integer" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "name_ar": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "description_ar": { "type": ["string", "null"] },
        "price": { "type": "number", "minimum": 0 },
        "imageSrc": { "type": ["string", "null"] },
        "stock_quantity": { "type": "number", "minimum": 0 },
        "sold_quantity": { "type": "number", "minimum": 0 },
        "reserved_quantity": { "type": "number", "minimum": 0 },
        "available_quantity": { "type": "number", "minimum": 0 },
        "category": { "enum": ["car_care", "tools", "accessories"] },
        "is_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Booking": {
      "type": "object",
      "required": [
        "id",
        "reference",
        "status",
        "status_label",
        "dispatch_state",
        "tracking_state",
        "tracking_available",
        "tracking_path",
        "scheduled_at",
        "scheduled_end_at",
        "service_date",
        "timezone",
        "duration_minutes",
        "duration_label",
        "duration",
        "time_range_label",
        "payment_method",
        "payment",
        "membership_applied",
        "membership_reserved",
        "loyalty_applied",
        "total",
        "product_total",
        "service_zone_rate",
        "payable_total",
        "dispatch_zone",
        "address_label",
        "address_area",
        "address_street",
        "building_number",
        "zone_number",
        "street_number",
        "notes",
        "service_area",
        "created_at",
        "cars",
        "products"
      ],
      "properties": {
        "id": { "type": "integer" },
        "reference": { "type": "string" },
        "status": { "$ref": "#/$defs/BookingStatus" },
        "status_label": { "type": "string" },
        "dispatch_state": { "$ref": "#/$defs/CustomerDispatchState" },
        "tracking_state": { "enum": ["disabled", "waiting", "available", "closed"] },
        "tracking_available": { "type": "boolean" },
        "tracking_path": { "type": "string", "pattern": "^/account\\?tab=bookings&booking=[1-9][0-9]*$" },
        "scheduled_at": { "type": ["string", "null"] },
        "scheduled_end_at": { "type": ["string", "null"] },
        "service_date": { "type": ["string", "null"] },
        "timezone": { "const": "Asia/Qatar" },
        "duration_minutes": { "type": "integer", "minimum": 0 },
        "duration_label": { "type": "string" },
        "duration": { "type": "object" },
        "time_range_label": { "type": ["string", "null"] },
        "payment_method": { "$ref": "#/$defs/PaymentMethod" },
        "payment_purchase_id": { "type": ["integer", "null"] },
        "payment": { "$ref": "#/$defs/PaymentState" },
        "refund": {
          "oneOf": [
            { "$ref": "#/$defs/RefundState" },
            { "type": "null" }
          ]
        },
        "membership_applied": { "type": "boolean" },
        "membership_reserved": { "type": "boolean" },
        "loyalty_applied": { "type": "boolean" },
        "total": { "type": "number", "minimum": 0 },
        "product_total": { "type": "number", "minimum": 0 },
        "service_zone_rate": { "type": "number", "minimum": 0 },
        "payable_total": { "type": "number", "minimum": 0 },
        "dispatch_zone": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id", "name_en", "name_ar", "version", "service_rate", "rate_applied"],
              "properties": {
                "id": { "type": "integer" },
                "name_en": { "type": "string" },
                "name_ar": { "type": "string" },
                "version": { "type": ["integer", "null"] },
                "service_rate": { "type": "number", "minimum": 0 },
                "rate_applied": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "address_label": { "type": ["string", "null"] },
        "address_area": { "type": "string" },
        "address_street": { "type": ["string", "null"] },
        "building_number": { "type": ["string", "null"] },
        "zone_number": { "type": ["string", "null"] },
        "street_number": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "service_area": { "type": "object" },
        "created_at": { "type": ["string", "null"] },
        "cars": { "type": "array" },
        "products": { "type": "array" }
      },
      "additionalProperties": false
    },
    "CustomerTrackingPosition": {
      "type": "object",
      "required": ["latitude", "longitude", "heading", "accuracy_m", "captured_at"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "heading": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
        "accuracy_m": { "type": "number", "minimum": 0 },
        "captured_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "CustomerTrackingSnapshot": {
      "type": "object",
      "required": [
        "schema_version", "server_time", "policy_revision", "booking_id", "dispatch_state",
        "assignment_version", "tracking_available", "reason", "trip", "bus", "position",
        "destination", "route", "eta", "delay", "health", "stream"
      ],
      "properties": {
        "schema_version": { "const": "customer-tracking-v1" },
        "server_time": { "type": "string", "format": "date-time" },
        "policy_revision": { "type": "integer", "minimum": 0 },
        "booking_id": { "type": "integer", "minimum": 1 },
        "dispatch_state": { "$ref": "#/$defs/CustomerDispatchState" },
        "assignment_version": { "type": "integer", "minimum": 0 },
        "tracking_available": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/CustomerTrackingReason" },
        "trip": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id", "status", "plan_revision", "window_starts_at", "arrived_at"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "status": { "enum": ["planned", "en_route", "arrived", "closed", "cancelled", "interrupted"] },
                "plan_revision": { "type": "integer", "minimum": 1 },
                "window_starts_at": { "type": "string", "format": "date-time" },
                "arrived_at": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "bus": {
          "oneOf": [
            {
              "type": "object",
              "required": ["bus_number", "plate_number"],
              "properties": {
                "bus_number": { "type": "string" },
                "plate_number": { "type": "string" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "position": { "oneOf": [{ "$ref": "#/$defs/CustomerTrackingPosition" }, { "type": "null" }] },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "route": {
          "oneOf": [
            {
              "type": "object",
              "required": ["encoded_polyline", "calculated_at", "expires_at"],
              "properties": {
                "encoded_polyline": { "type": "string" },
                "calculated_at": { "type": "string", "format": "date-time" },
                "expires_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "eta": {
          "oneOf": [
            {
              "type": "object",
              "required": ["arrival_at", "remaining_seconds", "source", "calculated_at", "expires_at"],
              "properties": {
                "arrival_at": { "type": "string", "format": "date-time" },
                "remaining_seconds": { "type": "integer", "minimum": 0 },
                "source": { "type": "string" },
                "calculated_at": { "type": "string", "format": "date-time" },
                "expires_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "delay": {
          "oneOf": [
            {
              "type": "object",
              "required": ["late_seconds", "source"],
              "properties": {
                "late_seconds": { "type": "integer", "minimum": 0 },
                "source": { "enum": ["predicted_arrival", "elapsed_booking_start"] }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "health": {
          "type": "object",
          "required": ["status", "last_valid_at", "last_received_at"],
          "properties": {
            "status": { "enum": ["healthy", "stale", "disconnected"] },
            "last_valid_at": { "type": ["string", "null"], "format": "date-time" },
            "last_received_at": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        },
        "stream": {
          "oneOf": [
            {
              "type": "object",
              "required": ["purpose", "epoch", "revision", "grant_id", "channel", "expires_at"],
              "properties": {
                "purpose": { "enum": ["dispatch", "tracking"] },
                "epoch": { "type": "string", "format": "uuid" },
                "revision": { "type": "integer", "minimum": 0 },
                "grant_id": { "type": "string", "format": "uuid" },
                "channel": { "type": "string", "pattern": "^private-fleet\\.customer\\.(dispatch|tracking)\\.[0-9a-f-]{36}$" },
                "expires_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "CustomerLiveAuthorization": {
      "type": "object",
      "required": ["auth", "channel", "grant_id", "purpose", "epoch", "revision", "expires_at"],
      "properties": {
        "auth": { "type": "string" },
        "channel": { "type": "string" },
        "grant_id": { "type": "string", "format": "uuid" },
        "purpose": { "enum": ["dispatch", "tracking"] },
        "epoch": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 0 },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "CustomerTrackingEvent": {
      "type": "object",
      "required": [
        "schema_version", "event_id", "type", "stream_epoch", "revision", "occurred_at",
        "policy_revision", "assignment_version", "trip_plan_revision", "booking_id", "trip_id", "payload"
      ],
      "properties": {
        "schema_version": { "const": "customer-tracking-event-v1" },
        "event_id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["tracking_available", "position_updated", "revoked", "closed", "feature_disabled"] },
        "stream_epoch": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "policy_revision": { "type": "integer", "minimum": 0 },
        "assignment_version": { "type": "integer", "minimum": 0 },
        "trip_plan_revision": { "type": ["integer", "null"], "minimum": 1 },
        "booking_id": { "type": "integer", "minimum": 1 },
        "trip_id": { "type": ["string", "null"], "format": "uuid" },
        "payload": {
          "type": "object",
          "properties": {
            "dispatch_state": { "$ref": "#/$defs/CustomerDispatchState" },
            "tracking_available": { "type": "boolean" },
            "reason": { "$ref": "#/$defs/CustomerTrackingReason" },
            "position": { "oneOf": [{ "$ref": "#/$defs/CustomerTrackingPosition" }, { "type": "null" }] },
            "destination": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["latitude", "longitude"],
                  "properties": {
                    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                    "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
                  },
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "route": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["encoded_polyline", "calculated_at", "expires_at"],
                  "properties": {
                    "encoded_polyline": { "type": "string" },
                    "calculated_at": { "type": "string", "format": "date-time" },
                    "expires_at": { "type": "string", "format": "date-time" }
                  },
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "eta": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["arrival_at", "remaining_seconds", "source", "calculated_at", "expires_at"],
                  "properties": {
                    "arrival_at": { "type": "string", "format": "date-time" },
                    "remaining_seconds": { "type": "integer", "minimum": 0 },
                    "source": { "type": "string" },
                    "calculated_at": { "type": "string", "format": "date-time" },
                    "expires_at": { "type": "string", "format": "date-time" }
                  },
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "delay": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["late_seconds", "source"],
                  "properties": {
                    "late_seconds": { "type": "integer", "minimum": 0 },
                    "source": { "enum": ["predicted_arrival", "elapsed_booking_start"] }
                  },
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "health": {
              "type": "object",
              "required": ["status", "last_valid_at", "last_received_at"],
              "properties": {
                "status": { "enum": ["healthy", "stale", "disconnected"] },
                "last_valid_at": { "type": ["string", "null"], "format": "date-time" },
                "last_received_at": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CustomerDataExportRequest": {
      "type": "object",
      "required": ["request_id", "token", "expires_at", "policy_version"],
      "properties": {
        "request_id": { "type": "integer", "minimum": 1 },
        "token": { "type": "string", "minLength": 64, "maxLength": 64 },
        "expires_at": { "type": "string", "format": "date-time" },
        "policy_version": { "const": "2026-07-18-v1" }
      },
      "additionalProperties": false
    },
    "CustomerDeletionResult": {
      "type": "object",
      "required": ["request_id", "completed_at", "policy_version", "retention"],
      "properties": {
        "request_id": { "type": "integer", "minimum": 1 },
        "completed_at": { "type": "string", "format": "date-time" },
        "policy_version": { "const": "2026-07-18-v1" },
        "retention": {
          "type": "object",
          "required": [
            "sessions_and_device_tokens",
            "otp_and_notification_delivery_logs",
            "security_and_access_logs",
            "support_records",
            "bookings_and_service_history",
            "financial_order_membership_ledgers",
            "legal_holds",
            "irreversibly_anonymous_statistics"
          ],
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "StoreOrder": {
      "type": "object",
      "required": [
        "id",
        "reference",
        "status",
        "status_label",
        "payment_status",
        "payment_status_label",
        "payment_method",
        "payment",
        "pricing",
        "delivery_area",
        "delivery_details",
        "building_number",
        "zone_number",
        "street_number",
        "latitude",
        "longitude",
        "service_area",
        "dispatch_zone",
        "base_delivery_fee",
        "service_zone_rate",
        "subtotal",
        "delivery_fee",
        "discount_total",
        "total",
        "notes",
        "lines",
        "expires_at",
        "created_at"
      ],
      "properties": {
        "id": { "type": "integer" },
        "reference": { "type": "string" },
        "status": { "$ref": "#/$defs/StoreOrderStatus" },
        "status_label": { "type": "string" },
        "payment_status": { "$ref": "#/$defs/StorePaymentStatus" },
        "payment_status_label": { "type": "string" },
        "payment_method": { "type": "string" },
        "payment_purchase_id": { "type": ["integer", "null"] },
        "payment": { "$ref": "#/$defs/PaymentState" },
        "refund": {
          "oneOf": [
            { "$ref": "#/$defs/RefundState" },
            { "type": "null" }
          ]
        },
        "pricing": { "type": "object" },
        "delivery_area": { "type": "string" },
        "delivery_details": { "type": ["string", "null"] },
        "building_number": { "type": ["string", "null"] },
        "zone_number": { "type": ["string", "null"] },
        "street_number": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "service_area": { "type": "object" },
        "dispatch_zone": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id", "name_en", "name_ar", "version", "service_rate", "rate_applied"],
              "properties": {
                "id": { "type": "integer" },
                "name_en": { "type": "string" },
                "name_ar": { "type": "string" },
                "version": { "type": ["integer", "null"] },
                "service_rate": { "type": "number", "minimum": 0 },
                "rate_applied": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "base_delivery_fee": { "type": ["number", "null"], "minimum": 0 },
        "service_zone_rate": { "type": ["number", "null"], "minimum": 0 },
        "subtotal": { "type": "number", "minimum": 0 },
        "delivery_fee": { "type": "number", "minimum": 0 },
        "discount_total": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "notes": { "type": ["string", "null"] },
        "lines": { "type": "array" },
        "expires_at": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
